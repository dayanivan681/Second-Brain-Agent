# Cadena de conexión de Supabase Postgres (Settings → Database → Connection string).
# Solo en el servidor; nunca en el Vault ni en el repositorio.
DATABASE_URL=
# Embeddings (búsqueda semántica). Verificar privacidad y precios antes de activar.
OPENAI_API_KEY=
# Modelo de chat del agente (p. ej. el que elijas tras revisar precios)
OPENAI_CHAT_MODEL=
